    "/nickname-availability": {
      "get": {
        "operationId": "nicknameAvailability",
        "summary": "Check whether a nickname is valid and free",
        "tags": [
          "profile"
        ],
        "parameters": [
          {
            "name": "nickname",
            "in": "query",
            "required": true,
            "description": "Nickname to check (case-insensitive).",
            "schema": {
              "type": "string",
              "maxLength": 100,
              "description": "Nickname to check (case-insensitive)."
            }
          }
        ],
        "security": [],
        "x-auth-level": "public",
        "responses": {
          "200": {
            "description": "OK",

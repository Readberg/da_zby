    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Liveness and database check",
        "tags": [
          "system"
        ],
        "security": [],
        "x-auth-level": "public",
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "API-Version": {
                "schema": {
                  "type": "string",
                  "const": "1"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "const": "ok",
                          "description": "The app is up and answering requests."
                        },
                        "checks": {
                          "type": "object",
                          "properties": {
                            "database": {
                              "type": "string",
                              "enum": [
                                "ok",
                                "error"
                              ],
                              "description": "Whether the database answered a probe query."
                            }
                          },
                          "required": [
                            "database"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "status",
                        "checks"
                      ],
                      "additionalProperties": false
                    },
                    "meta": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },

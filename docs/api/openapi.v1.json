                        },
                        "nickname": {
                          "description": "Null until onboarding is completed.",
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "fullName": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "contact": {
                          "description": "Public contact (Telegram, Instagram…).",
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "about": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "avatarUrl": {
                          "anyOf": [
                            {
                              "type": "string",
                              "format": "uri"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Public URL of the photo."
                        },
                        "countryCode": {
                          "description": "ISO 3166-1 alpha-2.",
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "city": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "utcOffsetMinutes": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991,
                          "description": "Display time zone as a fixed UTC offset."
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "user",
                            "admin"
                          ]
                        },
                        "email": {
                          "description": "Visible only to the owner of the profile.",
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "createdAt": {
                          "type": "string",

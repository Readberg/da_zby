                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "mePatch",
        "summary": "Update own profile",
        "description": "Partial update. The nickname can be set once (onboarding) and is locked afterwards; an empty string clears optional text fields. A photo is uploaded straight to storage (own folder, RLS) and then attached with `avatarPath`; `null` removes it. Role and e-mail cannot be changed here.",
        "tags": [
          "profile"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nickname": {
                    "type": "string",
                    "pattern": "^[A-Za-zА-Яа-яЁё0-9_]{3,20}$"
                  },
                  "fullName": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 100
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "contact": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "about": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 1000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "countryCode": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "city": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 100
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "avatarPath": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f-]{36}\\/[\\w-]{1,64}\\.(jpg|png|webp)$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "utcOffsetMinutes": {
                    "type": "integer",
                    "minimum": -720,
                    "maximum": 840
                  }
                }
              }
            }
          }
        },
        "x-auth-level": "user",
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "API-Version": {
                "schema": {
                  "type": "string",
                  "const": "1"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
